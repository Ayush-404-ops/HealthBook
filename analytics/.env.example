SECRET_KEY=django-insecure-healthbook-analytics-demo-key-2026
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration
# Leave DB_HOST blank to automatically fall back to SQLite (no Docker needed)
# Set DB_HOST=localhost (or db) to connect to PostgreSQL (via docker-compose)
DB_HOST=
DB_PORT=5432
DB_NAME=healthbook_analytics
DB_USER=hb_user
DB_PASSWORD=hb_secure_password_2026

# MongoDB URI for sync_from_mongo command
MONGO_URI=mongodb://localhost:27017/healthbook

# Salt for patient ID anonymization (SHA-256)
PATIENT_HASH_SALT=open-source-healthbook-salt-2026
